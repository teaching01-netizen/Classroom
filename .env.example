# Railway auto-injects (when using Railway Postgres plugin):
#   PORT
#   DATABASE_URL
# If NOT using Railway Postgres, set DATABASE_URL manually:
# DATABASE_URL=postgres://user:pass@host:5432/db

# Railway Serverless (formerly App Sleeping)
# Railway is auto-detected from RAILWAY_ENVIRONMENT_ID, but setting this explicitly
# makes the production intent clear. Set false to restore always-on warmers.
SERVERLESS_ENABLED=true
# Workers and active QR rooms stop after this much business inactivity.
# Accepted range: 30s to 6m. Default: 2m.
SERVERLESS_IDLE_GRACE=2m

# Must add in Railway dashboard:
WARWICK_EMAIL=
WARWICK_PASSWORD=
# Warwick UserID for course queries. Must match the authenticated session.
# If empty, uses the hardcoded default (may return empty courses).
WARWICK_USER_ID=
# Session pool sizing per traffic tier
# WARWICK_QR_SESSIONS: number of QR polling sessions (default: 2)
WARWICK_QR_SESSIONS=2
# WARWICK_TEACHER_SESSIONS: number of teacher/toggle sessions (default: 2)
WARWICK_TEACHER_SESSIONS=2
# WARWICK_INTERACTIVE_SESSIONS: number of interactive check-in sessions (default: 2)
WARWICK_INTERACTIVE_SESSIONS=2

# Shared HTTP transport — limits per-host connections
# WARWICK_CONNS_PER_HOST: max concurrent connections per host (default: 50)
WARWICK_CONNS_PER_HOST=50

# Max concurrent WebSocket connections (default: 500)
WARWICK_MAX_CONCURRENT_WS=500

# Optional (same-origin in Railway — no CORS needed):
# CORS_ORIGIN=https://your-custom-domain.com
# Optional (defaults to relative /ws — auto-detects origin):
# VITE_WS_URL=wss://your-app.railway.app/ws

# Concurrency settings for Warwick report computation
# WARWICK_REPORT_CONCURRENCY: max concurrent session detail fetches per report (default: 2)
WARWICK_REPORT_CONCURRENCY=2
# WARWICK_REPORT_RATE_PER_SECOND: rate limit for live session detail fetches (default: 2)
WARWICK_REPORT_RATE_PER_SECOND=2
# WARWICK_REPORT_RATE_BURST: burst size for rate limiter (default: 2)
WARWICK_REPORT_RATE_BURST=2
# WARWICK_COURSE_DETAIL_CONCURRENCY: max concurrent detail fetches during course enrichment (default: 2)
WARWICK_COURSE_DETAIL_CONCURRENCY=2

# Durable PostgreSQL snapshot scraper rollout flags.
# Enable writes first, verify coverage/host health, then enable snapshot reads.
# SNAPSHOT_READS_ENABLED=true requires SCRAPER_ENABLED=true.
SCRAPER_ENABLED=false
SNAPSHOT_READS_ENABLED=false

# Cluster-wide Warwick admission and scheduler bounds.
SCRAPER_REQUESTS_PER_SECOND=1
SCRAPER_BURST=1
SCRAPER_MAX_CONCURRENCY=2
SCRAPER_LEASE_DURATION=2m
SCRAPER_FETCH_TIMEOUT=30s
SCRAPER_PERMIT_GRACE=10s
SCRAPER_COMMIT_GRACE=15s
SCRAPER_TICK_LIMIT=50
SCRAPER_CLAIM_PREFETCH_FACTOR=2

# Decoded response and canonical PostgreSQL JSON payload ceilings (bytes).
SCRAPER_RESPONSE_BODY_LIMIT=16777216
SCRAPER_CANONICAL_PAYLOAD_LIMIT=16777216

# Snapshot/run history retention and sampled HTTP timing.
SCRAPER_SNAPSHOT_RETENTION=720h
SCRAPER_RUN_RETENTION=720h
SCRAPER_HTTPTRACE_SAMPLE_RATE=0.01

# Required when SCRAPER_ENABLED=true in serverless mode. Store this only in
# deployment secrets and send it as Authorization: Bearer <token>.
SCRAPER_TRIGGER_TOKEN=
